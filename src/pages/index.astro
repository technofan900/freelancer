---
import PortfolioModals from "../components/PortfolioModel.astro";
import BtcPrice from "../components/BtcPrice.astro";
/*
  src/pages/index.astro
  Converted from user's index.html (see citation above).
  Notes:
  - Put style.css into "public/style.css" or update the href to point to your CSS location.
  - Place images under "public/assets/img/" (e.g. public/assets/img/profile.png, public/assets/img/pumpkin.webp).
  - If you want to use Astro components or layouts later, move markup into a layout and replace this page's body with <Layout> slots.
*/
---
<!doctype html>
<html data-bs-theme="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>Home - Korporācija VCB</title>
    <!-- Keep or move these to a layout/head partial as you prefer -->
    <!-- Bootstrap CSS (needed for modal styles) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="src/styles/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
  </head>

  <body id="page-top" data-bs-spy="scroll" data-bs-target="#mainNav" data-bs-offset="72">
    <nav class="navbar navbar-expand-lg fixed-top bg-secondary text-uppercase" id="mainNav">
      <div class="container">
        <a class="navbar-brand" href="#page-top">Brand</a>
        <div class="collapse navbar-collapse" id="navbarResponsive">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item mx-0 mx-lg-1"><a class="nav-link px-0 px-lg-3 py-3 rounded" href="#portfolio">Portfolio</a></li>
            <li class="nav-item mx-0 mx-lg-1"><a class="nav-link px-0 px-lg-3 py-3 rounded" href="#about">About</a></li>
            <li class="nav-item mx-0 mx-lg-1"><a class="nav-link px-0 px-lg-3 py-3 rounded" href="#contact">Contact</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <header class="text-center text-white bg-primary masthead">
      <div class="container">
        <!-- make sure this image exists at public/assets/img/profile.svg (placeholder provided) -->
        <img class="img-fluid d-block mb-5 mx-auto" src="/assets/img/profile.svg" alt="profile" />
        <h1>Stepans Gavrilovs</h1>
        <hr class="star-light" />
        <h2 class="fw-light mb-0">Web and Robotics Developer, Cybersecurity Specialist</h2>
      </div>
      <BtcPrice />
    </header>

    <section id="portfolio" class="portfolio">
      <div class="container">
        <h2 class="text-uppercase text-center text-secondary">Portfolio</h2>
        <hr class="mb-5 star-dark" />
        <div class="row">
          <!-- Fixed image src paths from local Windows paths to web-friendly paths.
               Ensure pumpkin.webp is placed at public/assets/img/pumpkin.webp -->
          <div class="col-md-6 col-lg-4">
            <button class="d-block mx-auto portfolio-item btn btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#portfolio-modal-1" aria-label="Open portfolio item 1">
              <div class="position-absolute d-flex w-100 h-100 portfolio-item-caption">
                <div class="text-center text-white w-100 my-auto portfolio-item-caption-content"><i class="fa fa-search-plus fa-3x"></i></div>
              </div>
              <img class="img-fluid" src="/assets/img/pumpkin.svg" alt="portfolio item 1" />
            </button>
          </div>

          <div class="col-md-6 col-lg-4">
            <button class="d-block mx-auto portfolio-item btn btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#portfolio-modal-2" aria-label="Open portfolio item 2">
              <div class="position-absolute d-flex w-100 h-100 portfolio-item-caption">
                <div class="text-center text-white w-100 my-auto portfolio-item-caption-content"><i class="fa fa-search-plus fa-3x"></i></div>
              </div>
              <img class="img-fluid" src="/assets/img/pumpkin.svg" alt="portfolio item 2" />
            </button>
          </div>

          <div class="col-md-6 col-lg-4">
            <button class="d-block mx-auto portfolio-item btn btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#portfolio-modal-3" aria-label="Open portfolio item 3">
              <div class="position-absolute d-flex w-100 h-100 portfolio-item-caption">
                <div class="text-center text-white w-100 my-auto portfolio-item-caption-content"><i class="fa fa-search-plus fa-3x"></i></div>
              </div>
              <img class="img-fluid" src="/assets/img/pumpkin.svg" alt="portfolio item 3" />
            </button>
          </div>

          <div class="col-md-6 col-lg-4">
            <button class="d-block mx-auto portfolio-item btn btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#portfolio-modal-4" aria-label="Open portfolio item 4">
              <div class="position-absolute d-flex w-100 h-100 portfolio-item-caption">
                <div class="text-center text-white w-100 my-auto portfolio-item-caption-content"><i class="fa fa-search-plus fa-3x"></i></div>
              </div>
              <img class="img-fluid" src="/assets/img/pumpkin.svg" alt="portfolio item 4" />
            </button>
          </div>

          <div class="col-md-6 col-lg-4">
            <button class="d-block mx-auto portfolio-item btn btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#portfolio-modal-5" aria-label="Open portfolio item 5">
              <div class="position-absolute d-flex w-100 h-100 portfolio-item-caption">
                <div class="text-center text-white w-100 my-auto portfolio-item-caption-content"><i class="fa fa-search-plus fa-3x"></i></div>
              </div>
              <img class="img-fluid" src="/assets/img/pumpkin.svg" alt="portfolio item 5" />
            </button>
          </div>

          <div class="col-md-6 col-lg-4">
            <button class="d-block mx-auto portfolio-item btn btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#portfolio-modal-6" aria-label="Open portfolio item 6">
              <div class="position-absolute d-flex w-100 h-100 portfolio-item-caption">
                <div class="text-center text-white w-100 my-auto portfolio-item-caption-content"><i class="fa fa-search-plus fa-3x"></i></div>
              </div>
              <img class="img-fluid" src="/assets/img/pumpkin.svg" alt="portfolio item 6" />
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="text-white bg-primary mb-0" id="about">
      <div class="container">
        <h2 class="text-uppercase text-center text-white">About</h2>
        <hr class="mb-5 star-light" />
        <div class="row">
          <div class="col-lg-4 ms-auto">
            <p class="lead">Freelancer is a free bootstrap theme. The download includes the complete source files including HTML, CSS, and JavaScript as well as optional LESS stylesheets for easy customization.</p>
          </div>
          <div class="col-lg-4 me-auto">
            <p class="lead">Whether you're a student looking to showcase your work, a professional looking to attract clients, or a graphic artist looking to share your projects, this template is the perfect starting point!</p>
          </div>
        </div>
      </div>
    </section>
<section id="contact">
  <div class="container">
    <h2 class="text-uppercase text-center text-secondary mb-0">Contact Me</h2>
    <hr class="mb-5 star-dark" />
    <div class="row">
      <div class="col-lg-10 mx-auto">

        <form
          action="https://formspree.io/f/xkgeyqvj"
          method="POST"
        >

          <!-- Name -->
          <div class="mb-4 form-floating">
            <input class="form-control" type="text" id="name" name="name" required placeholder="Your Name" />
            <label class="form-label" for="name">Name</label>
          </div>

          <!-- Email -->
          <div class="mb-4 form-floating">
            <input class="form-control" type="email" id="email" name="email" required placeholder="name@example.com" />
            <label class="form-label" for="email">Email Address</label>
          </div>

          <!-- Subject -->
          <div class="mb-4 form-floating">
            <input class="form-control" type="text" id="subject" name="subject" required placeholder="Subject" />
            <label class="form-label" for="subject">Subject</label>
          </div>

          <!-- Message -->
          <div class="mb-5 form-floating">
            <textarea class="form-control" id="message" name="message" required placeholder="Message" style="height: 180px;"></textarea>
            <label class="form-label" for="message">Message</label>
          </div>

          <!-- Spam protection -->
          <input type="text" name="_gotcha" style="display:none" />

          <!-- Success redirect optional -->
          <input type="hidden" name="_next" value="/thank-you" />

          <div class="text-center">
            <button class="btn btn-primary btn-xl" id="sendMessageButton" type="submit">Send</button>
          </div>

        </form>
      </div>
    </div>
  </div>

  <style>
    #contactForm .form-control {
      width: 100%;
      font-size: 1.1rem;
      padding: 18px 16px;
    }
    #contactForm textarea {
      resize: vertical;
      min-height: 180px;
    }
    @media (min-width: 992px) {
      #contactForm {
        max-width: 900px;
        margin: 0 auto;
      }
    }
  </style>
</section>


    <footer class="text-center footer">
      <div class="container">
        <div class="row">
          <div class="row-location col-md-4 mb-5 mb-lg-0">
            <h4 class="text-uppercase mb-4">Location</h4>
            <p>2215 John Daniel Drive<br />Clark, MO 65243</p>
          </div>

          <div class="row-web col-md-4 mb-5 mb-lg-0">
            <h4 class="text-uppercase">Around the Web</h4>
            <ul class="list-inline">
              <li class="list-inline-item"><a class="btn btn-outline-light text-center btn-social rounded-circle" role="button" href="#"><i class="fa fa-facebook fa-fw"></i></a></li>
              <li class="list-inline-item"><a class="btn btn-outline-light text-center btn-social rounded-circle" role="button" href="#"><i class="fa fa-google-plus fa-fw"></i></a></li>
              <li class="list-inline-item"><a class="btn btn-outline-light text-center btn-social rounded-circle" role="button" href="#"><i class="fa fa-twitter fa-fw"></i></a></li>
              <li class="list-inline-item"><a class="btn btn-outline-light text-center btn-social rounded-circle" role="button" href="#"><i class="fa fa-dribbble fa-fw"></i></a></li>
            </ul>
          </div>

          <div class="row-about col-md-4">
            <h4 class="text-uppercase mb-4">About Freelancer</h4>
            <p class="lead mb-0"><span>Freelance is a free to use, open source Bootstrap theme.&nbsp;</span></p>
          </div>
        </div>
      </div>
    </footer>

    <div class="text-center text-white py-4 copyright">
      <div class="container"><small>Copyright © Korporācija VCB 2025</small></div>
    </div>

    <!-- Portfolio modals (rendered from src/components/PortfolioModel.astro) -->
    <PortfolioModals />

    <!-- Bootstrap JS bundle (required for modal behavior) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  </body>
</html>
